{
  "_comment": "German voice-command suite for tool-calling quality. 'expect' is the expected tool name (null = the model should answer without a tool). 'alt' lists other tools that are also acceptable. 'args' maps argument name -> list of acceptable values; strings match case-insensitively as substrings, numbers must match exactly. The tool catalog below is the TARGET catalog (M0 benchmark) - eval/bench_llm.py --registry uses the live backend registry instead.",
  "catalog": [
    {"name": "get_current_time", "description": "Aktuelle lokale Uhrzeit und Datum abfragen.", "parameters": {"type": "object", "properties": {}}},
    {"name": "media_control", "description": "Medienwiedergabe steuern (Spotify, Browser usw.): Wiedergabe pausieren, fortsetzen, nächster oder vorheriger Titel.", "parameters": {"type": "object", "properties": {"action": {"type": "string", "enum": ["play_pause", "next", "previous"]}}, "required": ["action"]}},
    {"name": "set_volume", "description": "Systemlautstärke setzen. Entweder absolute Lautstärke in Prozent (level) oder relativ lauter/leiser (direction), oder stumm schalten.", "parameters": {"type": "object", "properties": {"level": {"type": "integer", "minimum": 0, "maximum": 100}, "direction": {"type": "string", "enum": ["up", "down"]}, "mute": {"type": "boolean"}}}},
    {"name": "get_volume", "description": "Aktuelle Systemlautstärke in Prozent abfragen.", "parameters": {"type": "object", "properties": {}}},
    {"name": "find_files", "description": "Dateien anhand eines Suchbegriffs im Dateinamen finden (nur Pfade, kein Inhalt).", "parameters": {"type": "object", "properties": {"query": {"type": "string"}, "modified_year": {"type": "integer"}}, "required": ["query"]}},
    {"name": "read_file", "description": "Textinhalt einer Datei lesen.", "parameters": {"type": "object", "properties": {"path": {"type": "string"}}, "required": ["path"]}},
    {"name": "open_app", "description": "Eine freigegebene Anwendung starten (z. B. spotify, rechner, notepad, browser).", "parameters": {"type": "object", "properties": {"name": {"type": "string"}}, "required": ["name"]}},
    {"name": "set_timer", "description": "Timer oder Erinnerung stellen. Dauer in Sekunden, optional mit Text.", "parameters": {"type": "object", "properties": {"seconds": {"type": "integer"}, "label": {"type": "string"}}, "required": ["seconds"]}},
    {"name": "read_clipboard", "description": "Text aus der Zwischenablage lesen.", "parameters": {"type": "object", "properties": {}}},
    {"name": "write_clipboard", "description": "Text in die Zwischenablage kopieren.", "parameters": {"type": "object", "properties": {"text": {"type": "string"}}, "required": ["text"]}},
    {"name": "save_note", "description": "Eine Notiz speichern.", "parameters": {"type": "object", "properties": {"text": {"type": "string"}, "title": {"type": "string"}}, "required": ["text"]}},
    {"name": "remember", "description": "Einen dauerhaften Fakt oder eine Vorliebe über den Nutzer merken.", "parameters": {"type": "object", "properties": {"fact": {"type": "string"}}, "required": ["fact"]}},
    {"name": "forget", "description": "Einen gemerkten Fakt wieder vergessen/löschen.", "parameters": {"type": "object", "properties": {"query": {"type": "string"}}, "required": ["query"]}},
    {"name": "get_weather", "description": "Wetter und Vorhersage für einen Ort abfragen.", "parameters": {"type": "object", "properties": {"location": {"type": "string"}, "day": {"type": "string", "enum": ["today", "tomorrow"]}}, "required": ["location"]}},
    {"name": "web_search", "description": "Im Internet suchen. Liefert Titel, Ausschnitt und URL der Treffer.", "parameters": {"type": "object", "properties": {"query": {"type": "string"}}, "required": ["query"]}},
    {"name": "fetch_url", "description": "Eine bestimmte Webseite abrufen und ihren Text zurückgeben.", "parameters": {"type": "object", "properties": {"url": {"type": "string"}}, "required": ["url"]}},
    {"name": "get_system_info", "description": "Systemzustand des PCs: CPU-Auslastung, RAM, Uhrzeit.", "parameters": {"type": "object", "properties": {}}}
  ],
  "cases": [
    {"id": "time", "prompt": "Wie spät ist es?", "expect": "get_current_time"},
    {"id": "date", "prompt": "Welcher Tag ist heute?", "expect": "get_current_time"},
    {"id": "vol_down", "prompt": "Mach leiser.", "expect": "set_volume", "args": {"direction": ["down"]}},
    {"id": "music_quieter", "prompt": "Mach die Musik leiser.", "expect": "set_volume", "args": {"direction": ["down"]}},
    {"id": "vol_up", "prompt": "Lauter bitte.", "expect": "set_volume", "args": {"direction": ["up"]}},
    {"id": "vol_set", "prompt": "Stell die Lautstärke auf 30 Prozent.", "expect": "set_volume", "args": {"level": [30]}},
    {"id": "mute", "prompt": "Ton aus.", "expect": "set_volume", "args": {"mute": [true]}},
    {"id": "vol_get", "prompt": "Wie laut ist es gerade eingestellt?", "expect": "get_volume"},
    {"id": "pause", "prompt": "Pausier die Musik.", "expect": "media_control", "args": {"action": ["play_pause"]}},
    {"id": "next", "prompt": "Nächster Song.", "expect": "media_control", "args": {"action": ["next"]}},
    {"id": "prev", "prompt": "Spiel das vorherige Lied nochmal.", "expect": "media_control", "args": {"action": ["previous"]}},
