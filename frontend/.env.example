# Copy to .env in this folder (frontend/.env) - only needed for the Vite dev server.
# Backend address. Leave empty when the backend serves the frontend itself.
VITE_API_BASE_URL=http://localhost:8000
# NOTE: there is no token here any more. The UI gets it automatically on this PC
# (/api/auth/session); other devices pair once with the code shown in the UI.
# Watch out: frontend/.env.local silently overrides values in this file.
