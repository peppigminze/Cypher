# =========================================================
# Cypher – V1 Environment Configuration
# Copy this file to ".env" in the project root and adjust it.
# NEVER commit the real ".env" file.
# =========================================================

APP_ENV=development

# --- Database ---
# Path is relative to backend/ when the backend is started there.
DATABASE_URL=sqlite:///./jarvis.db

# --- Local LLM (Ollama or any OpenAI-compatible local runtime) ---
# Cypher talks to LOCAL_LLM_BASE_URL + "/v1/chat/completions"
# (this is the OpenAI-compatible endpoint Ollama exposes since v0.1.x)
LLM_PROVIDER=local
LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=qwen2.5:7b
LOCAL_LLM_TIMEOUT_SECONDS=60

# --- API server ---
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated list of origins allowed to call the API (frontend dev server, PWA, etc.)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Auth tokens ---
# Used by the frontend / user client to call the API.
USER_TOKEN=change-me-user-token
# Used by the local PC agent (agent/) to call the API.
AGENT_TOKEN=change-me-agent-token

# --- Local PC Agent (agent/run_agent.py) ---
# Base URL of the backend the agent talks to. For V1 this is the same
# machine, but the architecture allows this to point at a remote/cloud
# backend later without code changes.
BACKEND_BASE_URL=http://localhost:8000
AGENT_POLL_INTERVAL_SECONDS=5
AGENT_HEARTBEAT_INTERVAL_SECONDS=15

# --- Cloud LLM fallback (optional, disabled by default) ---
# LOCAL FIRST, always: the cloud provider is only ever tried when the
# local LLM itself is unreachable, and only if enabled here AND an API
# key is set. Leave CLOUD_LLM_ENABLED=false for zero cloud cost.
CLOUD_LLM_ENABLED=false
CLOUD_LLM_BASE_URL=https://api.openai.com/v1
CLOUD_LLM_MODEL=gpt-4o-mini
CLOUD_LLM_API_KEY=
CLOUD_LLM_TIMEOUT_SECONDS=30

# --- Local speech-to-text (faster-whisper, fully local/offline) ---
# "base" is the default speed/accuracy balance on CPU; "small" is more
# accurate but slower per request. Model weights are downloaded once
# (from Hugging Face) on first use and cached locally.
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- Local text-to-speech (Piper voice via sherpa-onnx, fully local/offline) ---
# Path relative to backend/. The voice files (de_DE-thorsten-medium.onnx +
# tokens.txt + espeak-ng-data/) ship in the repo under backend/models/piper/.
PIPER_MODEL_DIR=models/piper/de_DE-thorsten-medium
PIPER_NUM_THREADS=2
PIPER_SPEAKER_ID=0
PIPER_SPEED=1.0

# --- Wake-on-LAN (informational - see scripts/wake_pc.py) ---
# Your PC's MAC address (find it with `ipconfig /all` under "Physical
# Address"). Also needs Wake-on-LAN enabled in BIOS/UEFI and in the
# network adapter's power management settings.
WAKE_ON_LAN_MAC=
WAKE_ON_LAN_BROADCAST=255.255.255.255
WAKE_ON_LAN_PORT=9

# --- PC control tools (files, terminal) ---
# Comma-separated list of absolute directories Cypher's file/terminal
# tools are allowed to touch. Empty by default - nothing outside these
# directories is reachable, no matter what the LLM asks for, and
# writing/deleting/running commands ALWAYS requires confirmation in the
# app regardless of this setting.
# Example: ALLOWED_DIRECTORIES=C:\Users\you\Documents\Projects,C:\Users\you\Desktop
ALLOWED_DIRECTORIES=
TERMINAL_TIMEOUT_SECONDS=30

# --- Sync/message retries ---
# A message that fails because the local LLM was unreachable gets
# requeued instead of failing permanently, up to this many times, with
# an increasing backoff so a down Ollama isn't hammered every poll.
MESSAGE_MAX_RETRIES=3
MESSAGE_RETRY_BACKOFF_SECONDS=15
