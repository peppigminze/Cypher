# =========================================================
# Cypher – Konfiguration
# Kopiere diese Datei nach ".env" (im Projekt-Root, NICHT in backend/)
# und passe sie an. Die echte ".env" NIE committen.
# Alle Werte werden beim Start geprüft – Tippfehler führen zu einer
# klaren Fehlermeldung statt zu seltsamem Verhalten später.
# =========================================================

APP_ENV=development

# --- Datenbank ---
# Relativ zu backend/.
DATABASE_URL=sqlite:///./jarvis.db

# --- Lokales LLM (Ollama) ---
LLM_PROVIDER=local
# 127.0.0.1 statt localhost: Windows versucht bei localhost zuerst IPv6 (::1), was bei
# gestopptem Ollama jede Fehlermeldung um ~1 s verzögert.
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
# Gewählt im M0-Benchmark (docs/overhaul/AUDIT.md): bestes Verhältnis aus
# Qualität, Tempo und Grafikspeicher (~5,8 GB VRAM bei 8k Kontext).
LOCAL_LLM_MODEL=qwen3.5:9b
# Kleineres, schnelleres Modell (3,3 GB) – Fallback/Alternative.
LOCAL_LLM_FALLBACK_MODEL=qwen3.5:4b
# Maximale Wartezeit zwischen zwei gestreamten Antwortteilen (Sekunden).
LOCAL_LLM_TIMEOUT_SECONDS=60
LOCAL_LLM_CONNECT_TIMEOUT_SECONDS=3
# Kontextfenster in Tokens. Ollama würde sonst selbst 4096 wählen und lange
# Prompts still abschneiden. 12288 reicht für alle Werkzeuge inkl. PC-Steuerung
# (Kontext-Budget: /api/diagnostics bzw. doctor).
LOCAL_LLM_NUM_CTX=12288
# Wie lange das Modell nach der letzten Anfrage im Grafikspeicher bleibt
# (z. B. 30m, 2h, -1 = immer). Ollamas Standard (5m) führte zu 7–14 s
# Kaltstart nach kurzen Pausen.
LOCAL_LLM_KEEP_ALIVE=30m
# "Nachdenk-Modus" von Qwen 3.5 – sehr langsam (5–30 s), für Sprache aus.
LOCAL_LLM_THINK=false
LLM_TEMPERATURE=0.3
# Modell beim Start vorladen (erste Antwort dann ohne Wartezeit).
LLM_WARMUP_ON_START=true
# Andere Ollama-Modelle beim Start entladen. Unter Windows wird zu voller
# Grafikspeicher still in den Arbeitsspeicher ausgelagert (10–20× langsamer).
LLM_SINGLE_MODEL_POLICY=true
# Prüfintervall für Ollama in Sekunden (Neustart von Ollama wird erkannt).
LLM_MONITOR_INTERVAL_SECONDS=15
# Ab so viel ausgelagertem Modell (GB) meldet die Diagnose eine Warnung.
GPU_SHARED_SPILL_WARN_GB=0.5
AGENT_MAX_STEPS=5
APPROVAL_TTL_SECONDS=300

# --- API-Server ---
# Nur wirksam beim Start über "python run.py" bzw. start_cypher.bat.
#   127.0.0.1      -> nur dieser PC (Standard)
#   Fürs Handy NICHT ändern: "tailscale serve" leitet HTTPS an 127.0.0.1
#   weiter (docs/MOBILE.md). <Tailscale-IP> geht auch, dann ohne Mikrofon.
#   0.0.0.0        -> ganzes Netzwerk (nicht empfohlen)
API_HOST=127.0.0.1
API_PORT=8000
# Genaue Adressen, von denen das Frontend geladen wird – NIE "*".
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Zugangs-Tokens ---
# Leer lassen oder Platzhalter: Cypher erzeugt beim ersten Start zufällige
# Tokens in data/secrets.json. Die PC-Oberfläche holt sich den Token selbst;
# Handy/Tablet koppelst du einmalig mit dem Kopplungscode aus der Oberfläche.
# Eigene Werte sind möglich (mind. 24 Zeichen, sonst kein Netzwerkzugriff).
USER_TOKEN=
AGENT_TOKEN=

# --- Tools ---
TOOL_TIMEOUT_SECONDS=30
# Das LLM sieht eine kuratierte Auswahl. Weitere Tools per Name freischalten
# (z. B. list_tasks,git_status) oder einzelne ausblenden.
TOOLS_EXTRA=
TOOLS_DISABLED=
FILE_READ_MAX_BYTES=200000
FILE_WRITE_MAX_BYTES=1000000
# duckduckgo (ohne Konto) | searxng (eigene Instanz, SEARXNG_URL) | off
WEB_SEARCH_PROVIDER=duckduckgo
SEARXNG_URL=
WEB_SEARCH_MAX_RESULTS=5
# So viele Zeichen einer Webseite bekommt das Modell (kleiner Kontext!).
FETCH_MAX_CHARS=6000
# Apps, die open_app starten darf: name=ziel (exe, URI wie spotify: oder URL).
# Nur diese – das Modell kann keine beliebigen Befehle starten.
APP_WHITELIST=rechner=calc.exe,taschenrechner=calc.exe,editor=notepad.exe,notepad=notepad.exe,explorer=explorer.exe,spotify=spotify:,browser=https://duckduckgo.com,einstellungen=ms-settings:
# Ort für "Wie ist das Wetter?" ohne Ortsangabe, z. B. Bern.
WEATHER_DEFAULT_LOCATION=
# Bildschirm beschreiben mit dem lokalen Vision-Modell (Bild verlässt nie den PC).
VISION_ENABLED=true
VOLUME_STEP_PERCENT=10
# Leer = data/notes
NOTES_DIR=

# --- Zeit ---
# IANA-Zeitzone, z. B. Europe/Zurich. Leer = Zeitzone des PCs.
TIMEZONE=

# --- Cloud-LLM (optional, nie automatisch) ---
# Leer lassen = keine Cloud-Kosten, kein Cloud-Zugriff.
CLOUD_LLM_ENABLED=false
CLOUD_LLM_BASE_URL=https://api.openai.com/v1
# Stand 2026-10-08: gpt-6-luna ist OpenAIs Empfehlung für günstige, häufige Anfragen.
CLOUD_LLM_MODEL=gpt-6-luna
CLOUD_LLM_API_KEY=
CLOUD_LLM_TIMEOUT_SECONDS=30
# Denkaufwand des Cloud-Modells: none | minimal | low | medium | high (low = schnelle Sprachantworten)
CLOUD_LLM_REASONING_EFFORT=low
# Kostenbremse pro Monat in USD (0 = keine). Danach lehnt die Cloud höflich ab, lokal geht weiter.
CLOUD_MONTHLY_BUDGET_USD=5
# Nur nötig für Modelle, die nicht in backend/app/llm/pricing.py stehen: "eingabe,gecacht,ausgabe" in USD pro 1M Tokens
CLOUD_PRICE_PER_1M=
# Wenn das lokale Modell ausfällt: Cypher FRAGT, ob es die Cloud nehmen soll (nie automatisch).
CLOUD_FALLBACK_OFFER=true

# --- Spracherkennung (faster-whisper, läuft auf der CPU) ---
# "small": ~1,1 s pro Befehl, deutlich genauer als "base" (M0-Benchmark).
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=8
WHISPER_BEAM_SIZE=5
# Feste Sprache (schneller und zuverlässiger bei kurzen Befehlen). Leer = automatisch.
WHISPER_LANGUAGE=de
# Hilft bei Eigennamen ("Cypher" statt "Süfer").
WHISPER_INITIAL_PROMPT=Hey Cypher.
WHISPER_WARMUP_ON_START=true

# --- Sprachausgabe (Piper-Stimme über sherpa-onnx) ---
# Relativ zu backend/. Download: python backend/scripts/download_piper_voice.py
PIPER_MODEL_DIR=models/piper/de_DE-thorsten-medium
PIPER_NUM_THREADS=2
PIPER_SPEAKER_ID=0
PIPER_SPEED=1.0
TTS_WARMUP_ON_START=true

# --- Sprach-Sitzung (Live-Modus über WebSocket) ---
# Start-Modus der Oberfläche: wake ("Hey Cypher"), auto (tippen, Cypher erkennt das Satzende), ptt (Funk)
VOICE_DEFAULT_MODE=auto
WAKE_WORD_ENABLED=true
WAKE_WORD_PHRASE=Hey Cypher
# Kleines Whisper-Modell nur für das Aktivierungswort (tiny = schnell, base = genauer).
WAKE_WORD_MODEL=tiny
# 0..1 - kleiner = reagiert leichter (auch fälschlich), grösser = strenger.
WAKE_WORD_THRESHOLD=0.85
WAKE_WORD_WINDOW_SECONDS=2.5
# Pausenerkennung (Silero-VAD): so lange Stille beendet deinen Satz.
VAD_THRESHOLD=0.5
VAD_SILENCE_MS=700
# Nach so viel Stille startet die Spracherkennung schon vorsorglich (0 = aus).
VAD_EARLY_PAUSE_MS=250
VAD_MIN_SPEECH_MS=250
VAD_PREROLL_MS=300
VAD_MAX_UTTERANCE_SECONDS=20
# Nach "Hey Cypher": so lange wird auf den eigentlichen Befehl gewartet.
LISTEN_TIMEOUT_SECONDS=8
# Modus "Hey Cypher": Nach jeder Antwort (sobald sie fertig abgespielt ist) hört
# Cypher so viele Sekunden weiter zu - Folgefragen ohne Aktivierungswort.
# 0 = aus. "Cypher, schlaf" beendet das Fenster sofort. Im Menü (Einstellungen)
# änderbar; der Wert dort hat Vorrang.
FOLLOWUP_WINDOW_SECONDS=10
# aec_text: Echo-Unterdrückung des Browsers + Abgleich mit dem eigenen Text (Unterbrechen per Stimme möglich)
# mic_gate: Mikrofon ignorieren, solange Cypher spricht (Unterbrechen nur per Tippen)
ECHO_GUARD=aec_text
# So viel Gesprächsverlauf (grob in Tokens) bekommt das Modell mit.
HISTORY_MAX_TOKENS=1500

# --- Logging ---
LOG_LEVEL=INFO
# Relativ zum Projekt-Root. Datei: logs/cypher.log (rotierend).
LOG_DIR=logs
LOG_FILE_MAX_BYTES=5000000
LOG_FILE_BACKUPS=5
LOG_JSON=true

# --- Lokale Daten (Memory, Notizen, Backups) ---
DATA_DIR=data
# Ziel von backup_cypher.bat (relativ = Projektordner, gitignored).
BACKUP_DIR=backups

# --- Oberfläche ---
# Das Backend liefert die gebaute Oberfläche (frontend/dist) selbst aus:
# http://127.0.0.1:8000 öffnet Cypher. false = nur API (z. B. mit Vite-Dev-Server).
SERVE_FRONTEND=true
FRONTEND_DIST=frontend/dist

# --- Gedächtnis ---
# Kern-Gedächtnis (data/core_memory.json) steht immer im Prompt - so gross darf es werden.
# Was nicht mehr passt, landet im durchsuchbaren Archiv (SQLite).
MEMORY_CORE_MAX_TOKENS=400
# Passende Archiv-Einträge werden der aktuellen Frage beigelegt (0 = nie).
MEMORY_RECALL_MAX_TOKENS=200
# Verbindet sich die Sprach-Oberfläche neu, geht das letzte Gespräch weiter,
# wenn es höchstens so viele Minuten her ist.
CONVERSATION_RESUME_MINUTES=30
# Gespeicherter Gesprächsverlauf wird nach so vielen Tagen gelöscht.
CONVERSATION_KEEP_DAYS=30

# --- Wake-on-LAN (nur Info, siehe scripts/wake_pc.py) ---
WAKE_ON_LAN_MAC=
WAKE_ON_LAN_BROADCAST=255.255.255.255
WAKE_ON_LAN_PORT=9

# --- PC-Steuerung (Dateien, Terminal) ---
# Komma-getrennte Ordner, auf die Datei-Tools zugreifen dürfen. Leer = keine.
ALLOWED_DIRECTORIES=
TERMINAL_TIMEOUT_SECONDS=30

# --- Dateisuche (find_files) ---
# Leer = dein Benutzerordner. Es werden nur Dateinamen durchsucht, keine Inhalte.
SEARCH_DIRECTORIES=
SEARCH_MAX_RESULTS=50

